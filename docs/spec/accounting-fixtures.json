    {
      "name": "capped_query",
      "input": {"window": {"start": 1000, "end": 2000}, "now": 3000, "cap": 2, "sources": [{"installation": "i1", "runtime": "linux", "observed": [[1000, 2000]], "records": [
        {"event_id": "000000000000000000000000000000a1"},
        {"event_id": "000000000000000000000000000000a2"},
        {"event_id": "000000000000000000000000000000a3"}
      ]}]},
      "expect": {"state": "partial", "calls": 2, "coverage": {"read": 2, "capped": true}}
    },
    {
      "name": "malformed_byte_pairs",
