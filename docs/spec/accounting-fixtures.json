{
  "schema": "agentq.accounting/1",
  "contract": "docs/spec/ACCOUNTING.md O1-O4; producer record docs/spec/COMPRESSION.md Stats record; aggregate agentq/accounting.rs",
  "rules": [
    "A case record that is an object without `attributes` is `base_record` overlaid with its keys; a value \"$absent\" removes that key. Other records (spans, strings) are used as written.",
    "`expect` is a subset of the aggregate: each listed object key matches recursively; an array matches in length and element by element; scalars match exactly.",
    "A case with `error` instead of `expect` is rejected as a whole: the error names that field, and no totals are produced.",
    "Copies of one event ID count once only when they agree on every known value; a copy may fill a provenance key another left null, else the ID is conflicting_duplicate.",
    "Every case with a known state also satisfies: outcomes sum = reasons sum = cohort calls sum = calls.",
    "Times are unix seconds; windows and observed intervals are half-open [start, end)."
  ],
  "input": {
    "window": "{start, end}: half-open source event time interval",
    "now": "observation time; a record later than now + 300 s is future_time and never enters totals",
    "cap": "optional records read per query (default 100000); reaching it sets coverage.capped",
    "bucket": "optional seconds; adds buckets[] with each sub-window's own state, calls and outcomes",
    "sources": "[{installation, runtime, observed: [[from, to]..], dropped, resets: count | [reset unix times], capped, unknown: why the source has no coverage, records: [§3 record | agentq.compress span | agentq.run span | other]}]"
  },
  "producer": {
    "journal": "data/telemetry.sqlite3 meta.journal {schema:1,since,resets,gaps,counts}; event and coverage commit atomically. A failed write leaves data/coverage.failed.* outside SQLite until a later committed reset clears only markers it saw. Legacy coverage.json is imported and preserved.",
    "since": "time of the first record the store holds without loss; a missing journal over held records or an unreadable journal restarts it at the next second (the reset second stays unproven) and appends a reset",
    "gaps": "Imported legacy failed-append intervals [time,time+1). SQLite failures roll back both event and journal and use external failure markers.",
    "counts": "Per-day canonical SQLite stats rows: +1 per new unique event ID, less intentional retention/pressure removals. Identical retries add nothing; conflicting IDs stay unknown. Counts rebuild from retained rows on reset. Unexpected row loss remains unknown.",
    "local source": "observed = [max(since, now - 7 days), now + 1) less gaps, always with unknown \"calls that wrote no evidence are undetectable\" (a call whose record and marker writes both fail leaves nothing), so local totals are lower bounds; no stats store, no journal, an unreadable journal or store, a coverage.failed.* marker (\"stats write failed\") or a retained rows fewer than their count (\"stats records lost\"): observed [] and unknown with that reason",
    "exported source": "observed [] and unknown \"exported events carry no coverage\"; a queue folder adds its dropped count"
  },
  "output": {
    "state": "complete: every source covers the window, nothing excluded, no legacy cohort, not capped; unknown: no coverage and no events; else partial",
    "lower_bound": "true when partial: totals are observed counts, never a complete-period rate",
    "calls, outcomes, reasons": "distinct event IDs in the window; null when unknown",
    "volume": "per adapter and engine, compressed calls only: compressed, paired, bytes_in, bytes_out (unit byte; MiB = 2^20 bytes), reduction = 1 - sum(out)/sum(in), excluded {unmeasured, invalid}, estimated_tokens {kind: estimate}",
    "cohorts": "per installation, runtime, version, profile, agent, adapter, tool, runner, engine, engine_version (null = unknown, never inferred): calls, outcomes, reasons, evidence (at most 3 event IDs)",
    "coverage": "sources[{state, observed, gaps, dropped, resets, records, reasons: [{reason: no_observation (with detail; no observed interval) | unproven (with detail; observed intervals under an unknown reason) | gap | reset | dropped | capped}]}], read, counted, duplicates, out_of_window, excluded {malformed, unsupported_schema, future_time, conflicting_duplicate}, legacy_run, capped, profile_unknown",
    "observed_tokens, task_effect": "unknown with a reason: core records carry no observed usage, and whole-task effect needs a separate paired experiment cohort"
  },
  "base_record": {
    "schema": 1,
    "time": 1500,
    "agent": "claude",
    "adapter": "run",
    "tool": "shell",
    "runner": "cargo test",
    "engine": "rtk",
    "outcome": "compressed",
    "reason": "compressed",
    "bytes_in": 4096,
    "bytes_out": 1024,
    "est_tokens_in": 1024,
    "est_tokens_out": 256,
    "duration_ms": 40,
    "ref": "rtk:fixture",
    "session": null,
    "turn": null,
    "tool_call": null,
    "exit_code": 0,
    "version": "0.6.0",
    "engine_version": "0.51.0"
  },
  "cases": [
    {
      "name": "valid_zero",
      "input": {"window": {"start": 1000, "end": 2000}, "now": 3000, "sources": [{"installation": "i1", "runtime": "linux", "observed": [[0, 5000]], "records": []}]},
      "expect": {"state": "complete", "lower_bound": false, "calls": 0, "outcomes": {"compressed": 0, "passed": 0, "failed": 0}, "reasons": {}, "volume": [], "cohorts": []}
    },
    {
      "name": "missing_source_is_unknown",
      "input": {"window": {"start": 1000, "end": 2000}, "now": 3000, "sources": [{"installation": "i1", "runtime": "linux", "observed": [], "records": []}]},
      "expect": {"state": "unknown", "calls": null, "outcomes": null, "reasons": null, "coverage": {"sources": [{"state": "unknown", "gaps": [[1000, 2000]]}]}}
    },
    {
      "name": "late_and_duplicate_delivery",
      "input": {"window": {"start": 1000, "end": 2000}, "now": 3000, "sources": [{"installation": "i1", "runtime": "linux", "observed": [[1000, 2000]], "records": [
        {"event_id": "000000000000000000000000000000e1", "time": 1500},
        {"event_id": "000000000000000000000000000000e2", "time": 1100},
        {"event_id": "000000000000000000000000000000e1", "time": 1500}
      ]}]},
      "expect": {"state": "complete", "calls": 2, "outcomes": {"compressed": 2, "passed": 0, "failed": 0}, "coverage": {"read": 3, "counted": 2, "duplicates": 1},
        "volume": [{"adapter": "run", "engine": "rtk", "compressed": 2, "paired": 2, "bytes_in": 8192, "bytes_out": 2048, "reduction": 0.75}]}
    },
    {
      "name": "conflicting_duplicate_counts_nowhere",
      "input": {"window": {"start": 1000, "end": 2000}, "now": 3000, "sources": [{"installation": "i1", "runtime": "linux", "observed": [[1000, 2000]], "records": [
        {"event_id": "000000000000000000000000000000e1"},
        {"event_id": "000000000000000000000000000000e1", "outcome": "passed", "reason": "not_smaller", "bytes_out": 4096},
        {"event_id": "000000000000000000000000000000e2"}
      ]}]},
      "expect": {"state": "partial", "lower_bound": true, "calls": 1, "coverage": {"excluded": {"conflicting_duplicate": 1}}}
    },
    {
      "name": "conflicting_known_provenance_counts_nowhere",
      "input": {"window": {"start": 1000, "end": 2000}, "now": 3000, "sources": [
        {"installation": "i1", "runtime": "linux", "observed": [[1000, 2000]], "records": [
          {"event_id": "000000000000000000000000000000e1", "profile": "opaque-p1"},
          {"event_id": "000000000000000000000000000000e3", "version": "0.6.0"},
          {"event_id": "000000000000000000000000000000e3", "version": "0.6.1"},
          {"event_id": "000000000000000000000000000000e2"}
        ]},
        {"installation": "i2", "runtime": "linux", "observed": [[1000, 2000]], "records": [
          {"event_id": "000000000000000000000000000000e1", "profile": "opaque-p1"}
        ]}
      ]},
      "expect": {"state": "partial", "lower_bound": true, "calls": 1, "coverage": {"counted": 1, "excluded": {"conflicting_duplicate": 2}},
        "cohorts": [{"installation": "i1", "calls": 1, "evidence": ["000000000000000000000000000000e2"]}]}
    },
    {
      "name": "compatible_duplicate_fills_unknown_provenance",
      "input": {"window": {"start": 1000, "end": 2000}, "now": 3000, "sources": [{"installation": "i1", "runtime": "linux", "observed": [[1000, 2000]], "records": [
        {"event_id": "000000000000000000000000000000e1", "version": "$absent"},
        {"event_id": "000000000000000000000000000000e1", "profile": "opaque-p1"}
      ]}]},
      "expect": {"state": "complete", "calls": 1, "coverage": {"duplicates": 1, "excluded": {}, "profile_unknown": 0},
        "cohorts": [{"profile": "opaque-p1", "version": "0.6.0", "calls": 1}]}
    },
    {
      "name": "half_open_boundaries",
      "input": {"window": {"start": 1000, "end": 2000}, "now": 3000, "sources": [{"installation": "i1", "runtime": "linux", "observed": [[1000, 2000]], "records": [
        {"event_id": "000000000000000000000000000000b1", "time": 999},
        {"event_id": "000000000000000000000000000000b2", "time": 1000},
        {"event_id": "000000000000000000000000000000b3", "time": 1999},
        {"event_id": "000000000000000000000000000000b4", "time": 2000}
      ]}]},
      "expect": {"state": "complete", "calls": 2, "coverage": {"out_of_window": 2, "counted": 2}}
    },
    {
      "name": "mixed_versions_and_recipes",
      "input": {"window": {"start": 1000, "end": 2000}, "now": 3000, "sources": [{"installation": "i1", "runtime": "linux", "observed": [[1000, 2000]], "records": [
        {"event_id": "000000000000000000000000000000c1"},
        {"event_id": "000000000000000000000000000000c2", "agent": "codex", "adapter": "provider", "tool": "exec_command", "engine": "headroom", "engine_version": "0.40.0", "version": "0.6.1", "bytes_in": 2000, "bytes_out": 1500, "est_tokens_in": 500, "est_tokens_out": 375, "exit_code": "$absent", "ref": "headroom:fixture"},
        {"event_id": "000000000000000000000000000000c3", "version": "$absent", "engine_version": "$absent", "bytes_in": 3904, "bytes_out": 976, "est_tokens_in": 976, "est_tokens_out": 244}
      ]}]},
      "expect": {"state": "complete", "calls": 3,
        "volume": [
          {"adapter": "provider", "engine": "headroom", "unit": "byte", "compressed": 1, "paired": 1, "bytes_in": 2000, "bytes_out": 1500, "reduction": 0.25, "excluded": {}},
          {"adapter": "run", "engine": "rtk", "unit": "byte", "compressed": 2, "paired": 2, "bytes_in": 8000, "bytes_out": 2000, "reduction": 0.75, "excluded": {},
            "estimated_tokens": {"kind": "estimate", "method": "ceil(bytes/4)", "paired": 2, "tokens_in": 2000, "tokens_out": 500}}
        ],
        "cohorts": [
          {"version": "0.6.0", "engine_version": "0.51.0", "engine": "rtk", "calls": 1},
          {"version": "0.6.1", "engine_version": "0.40.0", "engine": "headroom", "calls": 1},
          {"version": null, "engine_version": null, "engine": "rtk", "calls": 1, "evidence": ["000000000000000000000000000000c3"]}
        ]}
    },
    {
      "name": "unknown_profile_is_own_cohort",
      "input": {"window": {"start": 1000, "end": 2000}, "now": 3000, "sources": [{"installation": "i1", "runtime": "linux", "observed": [[1000, 2000]], "records": [
        {"event_id": "000000000000000000000000000000d1", "profile": "opaque-p1"},
        {"event_id": "000000000000000000000000000000d2"}
      ]}]},
      "expect": {"state": "complete", "calls": 2, "coverage": {"profile_unknown": 1}, "cohorts": [{"profile": "opaque-p1", "calls": 1}, {"profile": null, "calls": 1}]}
    },
    {
