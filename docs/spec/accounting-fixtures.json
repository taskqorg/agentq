      ]},
      "expect": {"state": "partial", "lower_bound": true, "calls": 2, "coverage": {"sources": [{"installation": "i1", "state": "complete"}, {"installation": "i2", "state": "partial", "dropped": 3}, {"installation": "i3", "state": "unknown"}]}}
