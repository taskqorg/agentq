        {"event_id": "000000000000000000000000000000a3", "outcome": "failed", "reason": "no_engine", "engine": "none", "engine_version": null, "bytes_in": null, "bytes_out": null, "est_tokens_in": null, "est_tokens_out": null, "ref": null},
        {"event_id": "000000000000000000000000000000a4", "outcome": "failed", "reason": "timeout", "bytes_out": 4096, "ref": null}
      ]}]},
      "expect": {"state": "complete", "calls": 4, "outcomes": {"compressed": 1, "passed": 1, "failed": 2}, "reasons": {"compressed": 1, "not_qualified": 1, "no_engine": 1, "timeout": 1},
        "volume": [{"compressed": 1, "paired": 1, "bytes_in": 4096, "bytes_out": 1024}]}
    },
