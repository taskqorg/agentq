      ]}]},
      "expect": {"state": "partial", "lower_bound": true, "calls": 1, "coverage": {"sources": [{"state": "partial", "observed": [[1000, 1500]], "gaps": [[1500, 2000]], "records": 1}]}}
    },
    {
      "name": "offline_source_with_dropped_events",
      "input": {"window": {"start": 1000, "end": 2000}, "now": 3000, "sources": [
        {"installation": "i1", "runtime": "linux", "observed": [[1000, 2000]], "records": [{"event_id": "000000000000000000000000000000a1"}]},
        {"installation": "i2", "runtime": "windows", "observed": [[1000, 2000]], "dropped": 3, "records": [{"event_id": "000000000000000000000000000000a2", "agent": "codex"}]},
